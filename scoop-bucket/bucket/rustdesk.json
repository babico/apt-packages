        }
    },
    "installer": {
        "script": [
            "$process = Start-Process -FilePath \"$dir\\rustdesk-1.4.9-x86_64.exe\" -ArgumentList @('/S') -Wait -PassThru",
            "exit $process.ExitCode"
        ]
    },
    "uninstaller": {
        "script": [
            "$process = Start-Process -FilePath \"$env:LOCALAPPDATA\\RustDesk\\rustdesk.exe\" -ArgumentList @('--uninstall', '/S') -Wait -PassThru",
            "exit $process.ExitCode"
        ]
    }
}
