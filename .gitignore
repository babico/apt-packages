
# The pool contains large .deb binaries — track only the index/metadata in git.
# CI downloads debs fresh each run from upstream GitHub releases.
docs/pool/**/*.deb

# .rpm files in pool are tracked (built by CI, served via Pages)

# Keep metadata in docs/
!docs/dists/
!docs/index.html
!docs/apt-repo.gpg

# Secrets / local keys
private.key
*.asc